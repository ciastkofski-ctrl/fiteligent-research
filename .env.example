# Anthropic API (synthesis step)
ANTHROPIC_API_KEY=sk-ant-...

# SMTP (email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
SMTP_FROM=you@example.com
SMTP_TO=you@example.com

# Optional: override default LLM model
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: base URL of the published digests directory (for email "Read full digest" link)
# Example: https://github.com/<user>/fiteligent-research/blob/main/digests
REPO_DIGEST_URL_BASE=
